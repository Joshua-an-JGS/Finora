# ============================================================================
# PaySlip Studio — Environment Configuration Template (.env.example)
# Copy to .env or set via OS Environment Variables / Secret Manager in production.
# NEVER commit actual secrets, passwords, or private keys to version control.
# ============================================================================

# --- Database (PostgreSQL 18+) ---
ConnectionStrings__DefaultConnection="Host=127.0.0.1;Port=5432;Database=payslip_studio;Username=postgres;Password=CHANGE_ME_IN_PRODUCTION"

# --- Authentication & JWT Security ---
Jwt__Issuer="PaySlipStudio.Server"
Jwt__Audience="PaySlipStudio.Client"
Jwt__SigningKey="REPLACE_WITH_SECURE_256_BIT_SECRET_KEY_AT_LEAST_32_BYTES"
Jwt__ExpirationMinutes="480"

# --- Initial Administrator Bootstrap ---
BootstrapAdmin__Email="admin@amtdc.org"
BootstrapAdmin__Username="admin"
BootstrapAdmin__InitialPassword="CHANGE_ME_IMMEDIATELY_ON_FIRST_BOOT!"
BootstrapAdmin__RequireMfa="false"

# --- Private File Storage ---
Storage__RootPath="./Storage/PrivateVault"
Storage__MaxUploadBytes="15728640"
Storage__RetentionDays="1095"

# --- Email / SMTP Provider Configuration ---
# Mode: "Sandbox" (safe local capture & audit without external network) or "Smtp" (live authenticated SMTP)
Email__ProviderMode="Sandbox"
Email__SmtpHost="smtp.office365.com"
Email__SmtpPort="587"
Email__UseStartTls="true"
Email__SmtpUsername="accounts-noreply@example.org"
Email__SmtpPassword="REPLACE_WITH_SMTP_APP_PASSWORD"
Email__FromAddress="accounts@example.org"
Email__FromName="Accounts Department — PaySlip Studio"

